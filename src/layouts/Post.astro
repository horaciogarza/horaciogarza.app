---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import PostGrid from '../components/PostGrid.astro';
import Share from '../components/Share.astro';
import Subscribe from '../components/Subscribe.astro';
import QuoteShare from '../components/QuoteShare.astro';
import AppStrip from '../components/AppStrip.astro';

interface Props {
  post: CollectionEntry<'posts'>;
  words: number;
  more?: CollectionEntry<'posts'>[];
}
const { post, words, more = [] } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
const minutes = Math.max(1, Math.round(words / 220));
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site).href;
const iso = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title={title} description={description} ogType="article">
  <article class="wrap">
    <header class="article-head prose">
      <p class="sql">SELECT * FROM posts WHERE id = '{post.id}';</p>
      <h1>{title}</h1>
      <p style="color:var(--fg-dim);margin-bottom:1rem">{description}</p>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{iso(pubDate)}</time>
        {updatedDate && <><span class="sep">|</span><span>updated {iso(updatedDate)}</span></>}
        <span class="sep">|</span><span>{words} words</span>
        <span class="sep">|</span><span>~{minutes} min</span>
        {tags.length > 0 && <span class="sep">|</span>}
        {tags.map((t) => <a class="tag" href={`/tags/${t}`}>{t}</a>)}
      </div>
    </header>

    {heroImage && (
      <figure class="article-hero prose">
        <Image src={heroImage} alt="" width={1280} height={800} loading="eager" />
      </figure>
    )}

    <div class="article-body prose">
      <slot />
    </div>

    <Share url={canonical} title={title} description={description} />

    <Subscribe />

    {more.length > 0 && (
      <section class="more-posts">
        <h2 class="section-h">More posts</h2>
        <p class="sql">SELECT * FROM posts WHERE id != '{post.id}' ORDER BY pub_date DESC LIMIT 4;</p>
        <PostGrid posts={more} />
      </section>
    )}

    <section class="post-apps">
      <AppStrip />
    </section>
  </article>

  <QuoteShare url={canonical} title={title} />

  <script>
    import '../scripts/quote-share.ts';
  </script>
</Base>
