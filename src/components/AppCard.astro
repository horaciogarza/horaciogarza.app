---
import type { App } from '../data/apps';
interface Props { app: App }
const { app } = Astro.props;
---
<article class="app-card reveal">
  <div class="app-card-top">
    <img class="app-icon" src={app.icon} alt="" width="56" height="56" loading="lazy" decoding="async" />
    <div class="app-id">
      <h3 class="app-name">{app.name}</h3>
      <p class="app-tagline">{app.tagline}</p>
    </div>
  </div>
  <span class:list={['badge', app.status === 'live' && 'live']}>
    {app.status === 'live' ? 'shipped' : 'in dev'}
  </span>
  <p class="app-desc">{app.description}</p>
  {app.appStore && (
    <p style="margin:0">
      <a class="appstore plain" href={app.appStore} target="_blank" rel="noopener noreferrer">
        <svg width="14" height="17" viewBox="0 0 24 29" aria-hidden="true" fill="currentColor"><path d="M19.9 15.3c0-3.4 2.8-5.1 2.9-5.2-1.6-2.4-4.1-2.7-5-2.7-2.1-.2-4.1 1.3-5.2 1.3-1.1 0-2.7-1.3-4.5-1.2-2.3 0-4.4 1.3-5.6 3.4-2.4 4.2-.6 10.3 1.7 13.7 1.1 1.6 2.5 3.5 4.3 3.4 1.7-.1 2.4-1.1 4.5-1.1s2.7 1.1 4.5 1.1c1.9 0 3-1.6 4.1-3.3 1.3-1.9 1.9-3.8 1.9-3.9-.1 0-3.6-1.4-3.6-5.5zM16.6 4.9c.9-1.2 1.6-2.8 1.4-4.4-1.4.1-3.1 1-4 2.1-.9 1-1.6 2.6-1.4 4.2 1.6.1 3.1-.8 4-1.9z"/></svg>
        App&nbsp;Store
      </a>
    </p>
  )}
  {app.links.length > 0 && (
    <div class="app-links">
      {app.links.map((l, i) => (
        <>
          {i > 0 && <span aria-hidden="true">·</span>}
          <a href={l.href}>{l.label}</a>
        </>
      ))}
    </div>
  )}
</article>
