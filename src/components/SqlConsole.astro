<aside class="console" id="sqlconsole" aria-hidden="true" aria-label="SQL query console">
  <pre class="console-out" id="sqlout" tabindex="0"></pre>
  <form class="console-form" id="sqlform" autocomplete="off">
    <span class="ps1">mysql&gt;</span>
    <input id="sqlinput" name="q" type="text" spellcheck="false" autocapitalize="off"
           placeholder="SELECT * FROM posts WHERE tag = 'swift';" aria-label="SQL query" />
    <button type="button" class="icon-btn" id="sqlclose" aria-label="Close console">esc</button>
  </form>
</aside>
