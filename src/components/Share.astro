---
interface Props {
  url: string;
  title: string;
  description?: string;
}
const { url, title, description } = Astro.props;

// -- lead with the hook, then the title. The description is already written
// -- as a one-line hook, so it is the best copy we have to open a share with.
const shareText = description ? `${description}\n\n${title}` : title;

const x = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(url)}`;
// LinkedIn's share-offsite takes no text param — it scrapes og:description,
// which Base.astro already fills from this same description.
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
// Reddit's field is a submission title: single-line, so the plain title fits better.
const reddit = `https://www.reddit.com/submit?url=${encodeURIComponent(url)}&title=${encodeURIComponent(title)}`;
---
<!-- INSERT INTO shares (post_url) VALUES (?); -->
<div class="share">
  <h2 class="section-h">Share this post</h2>
  <p class="sql">INSERT INTO shares (post, channel) VALUES (?, ?);</p>
  <div class="share-row">
    <a class="share-btn plain" href={x} target="_blank" rel="noopener noreferrer" aria-label="Share on X">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      X
    </a>
    <a class="share-btn plain" href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.58c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.38 4.28 5.47zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56z"/></svg>
      LinkedIn
    </a>
    <a class="share-btn plain" href={reddit} target="_blank" rel="noopener noreferrer" aria-label="Share on Reddit">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm5.5 11.34c0 2.3-2.47 4.16-5.5 4.16s-5.5-1.86-5.5-4.16c0-1.18.65-2.24 1.73-3-.08-.24-.13-.5-.13-.78 0-1.13.92-2.05 2.05-2.05.55 0 1.05.22 1.42.58.7-.37 1.53-.6 2.43-.63l.55-2.6a.35.35 0 0 1 .41-.27l1.85.39a1 1 0 1 1-.14.5l-1.6-.34-.47 2.24c.87.04 1.68.27 2.36.63.37-.35.86-.57 1.4-.57 1.13 0 2.05.92 2.05 2.05 0 .28-.05.54-.14.78 1.08.75 1.73 1.81 1.73 2.99zM8.5 12.7c-.6 0-1.08.5-1.08 1.1s.49 1.09 1.08 1.09 1.08-.49 1.08-1.09-.49-1.1-1.08-1.1zm7 0c-.6 0-1.08.5-1.08 1.1s.49 1.09 1.08 1.09 1.09-.49 1.09-1.09-.49-1.1-1.09-1.1zm-6.15 3.22a.35.35 0 0 0-.24.6c.64.6 1.75.97 2.9.97s2.25-.36 2.9-.97a.35.35 0 1 0-.48-.51c-.53.49-1.44.79-2.42.79s-1.9-.3-2.42-.79a.35.35 0 0 0-.24-.09z"/></svg>
      Reddit
    </a>
    <button class="share-btn" type="button" id="copylink" data-url={url} aria-label="Copy link">
      <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
      <span id="copylink-label">Copy link</span>
    </button>
  </div>
</div>

<script>
  const btn = document.getElementById('copylink');
  const label = document.getElementById('copylink-label');
  btn?.addEventListener('click', async () => {
    const url = btn.getAttribute('data-url') || location.href;
    try {
      await navigator.clipboard.writeText(url);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = url;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    }
    if (label) {
      const prev = label.textContent;
      label.textContent = 'Copied';
      setTimeout(() => { label.textContent = prev; }, 1600);
    }
  });
</script>
