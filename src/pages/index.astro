---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import AppStrip from '../components/AppStrip.astro';

const posts = (await getPosts()).slice(0, 6);
---
<Base title="home">
  <section class="wrap hero">
    <div class="prose" data-parallax="0.06">
      <p class="sql">USE horaciogarza;</p>
      <h1>Horacio Garza<span class="cursor" aria-hidden="true"></span></h1>
      <p class="lede">Data &amp; AI enthusiast, 10+ years of engineering experience.</p>
      <p class="console-hint">
        Press <kbd>/</kbd> to query this site.
      </p>
    </div>
  </section>

  <section class="wrap pb-sec">
    <h2 class="section-h">Posts</h2>
    <p class="sql">SELECT * FROM posts ORDER BY pub_date DESC LIMIT 6;</p>
    <PostList posts={posts} />
    <p class="mt-2"><a href="/blog">all posts →</a></p>
  </section>

  <section class="wrap pb-sec">
    <AppStrip />
  </section>

</Base>
