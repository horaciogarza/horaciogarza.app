---
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts, countWords } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      words: countWords(post.body),
      // list is newest-first, so the older post sits at the next index
      next: posts[i - 1],
      prev: posts[i + 1],
      more: posts.filter((p) => p.id !== post.id).slice(0, 3),
    },
  }));
}

const { post, words, prev, next, more } = Astro.props;
const { Content } = await render(post);
---
<Post post={post} words={words} prev={prev} next={next} more={more}>
  <Content />
</Post>
