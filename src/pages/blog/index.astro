---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<Base title="blog" description="Posts by Horacio Garza.">
  <section class="wrap pt-page pb-page">
    <h1>Blog</h1>
    <p class="sql">SELECT * FROM posts ORDER BY pub_date DESC;</p>
    {tags.length > 0 && (
      <div class="tags tags-filter">
        <span class="sql sql-inline">GROUP BY tag:</span>
        {tags.map((t) => <a class="tag" href={`/tags/${t}`}>{t}</a>)}
      </div>
    )}
    <div class="blog-search" hidden>
      <label class="ps1" for="blogfilter">WHERE title LIKE</label>
      <input
        id="blogfilter"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder="'%…%'"
        aria-label="Filter posts"
      />
    </div>

    <PostList posts={posts} />
    <p class="sql mt-1" id="blogempty" hidden>Empty set (0.00 sec)</p>
    <p class="sql mt-1"><span id="blogcount">{posts.length} row{posts.length === 1 ? '' : 's'} in set (0.00 sec)</span></p>
  </section>

  <script>
    import '../../scripts/blog-filter.ts';
  </script>
</Base>
