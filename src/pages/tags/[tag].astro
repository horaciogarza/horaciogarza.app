---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)), tag },
  }));
}

const { posts, tag } = Astro.props;
---
<Base title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <section class="wrap pt-page pb-page">
    <p class="sql">SELECT * FROM posts WHERE tag = '{tag}';</p>
    <h1>{tag}</h1>
    <PostList posts={posts} />
    <p class="sql" class="mt-1">{posts.length} row{posts.length === 1 ? '' : 's'} in set (0.00 sec)</p>
    <p class="mt-1"><a href="/blog">← all posts</a></p>
  </section>
</Base>
